# PostgreSQL local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Food_Beverage
DB_ADMIN_NAME=postgres
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=prefer
SECRET_KEY=CHANGE_THIS_WITH_A_LONG_RANDOM_VALUE

# Recuperación de contraseña por Gmail SMTP
APP_BASE_URL=http://127.0.0.1:5000
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USERNAME=cuenta@gmail.com
MAIL_APP_PASSWORD=CHANGE_ME
MAIL_FROM_NAME=ZYMA 360 Food Plant AI Copilot
PREDICTIVE_CAPTURE_INTERVAL=900

# En nube puedes usar una URL completa en lugar de las variables anteriores.
# DATABASE_URL=postgresql://usuario:password@servidor:5432/Food_Beverage
