# Ollama instalado en el host VPS
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=300
OLLAMA_MAX_TOKENS=220
SESSION_IDLE_TIMEOUT_SECONDS=1800
