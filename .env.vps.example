# Copiar como .env en el VPS. No subir .env a Git.
DB_HOST=db
DB_PORT=5432
DB_NAME=Food_Beverage
DB_ADMIN_NAME=postgres
DB_USER=food_app
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_LARGO
DB_SSLMODE=disable

SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_DE_64_CARACTERES
SESSION_COOKIE_SECURE=1
APP_PORT=5000
APP_BASE_URL=https://tu-dominio.com

MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USERNAME=tu_cuenta@gmail.com
MAIL_APP_PASSWORD=REEMPLAZAR_CON_PASSWORD_DE_APLICACION
MAIL_FROM_NAME=ZYMA 360 Food Plant AI Copilot
PREDICTIVE_CAPTURE_INTERVAL=900
DOWNTIME_CAPTURE_INTERVAL=900
